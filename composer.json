{
    "name": "baijunyao/laravel-support",
    "keywords": [
        "laravel",
        "support"
    ],
    "description": "Laravel Support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "baijunyao",
            "email": "baijunyao@baijunyao.com"
        }
    ],
    "require": {
        "illuminate/support": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Baijunyao\\LaravelSupport\\": "src/",
            "Baijunyao\\LaravelSupport\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.5",
        "orchestra/testbench": "^9.1|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "larastan/larastan": "^3.0"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse --ansi",
        "phpunit": "vendor/bin/phpunit -c phpunit.xml"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Baijunyao\\LaravelSupport\\SupportServiceProvider"
            ]
        }
    }
}
